{
  "name": "experiment-planner",
  "productName": "Experiment Planner",
  "description": "A local-first experiment and task planner built around a full-screen monthly calendar.",
  "private": true,
  "version": "0.2.1",
  "author": {
    "name": "BRPollak",
    "url": "https://github.com/BRPollak"
  },
  "license": "UNLICENSED",
  "homepage": "https://github.com/BRPollak/experiment-planner#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BRPollak/experiment-planner.git"
  },
  "bugs": {
    "url": "https://github.com/BRPollak/experiment-planner/issues"
  },
  "type": "module",
  "main": "dist-electron/main.mjs",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "desktop:typecheck": "tsc --noEmit -p electron/tsconfig.json",
    "desktop:compile": "npm run desktop:typecheck && node electron/build.mjs",
    "desktop:prepare": "npm run build && npm run desktop:compile",
    "desktop:run": "npm run desktop:prepare && electron .",
    "desktop:pack": "npm run desktop:prepare && electron-builder --mac dir --arm64 --publish never",
    "desktop:dist": "npm run desktop:prepare && electron-builder --mac dmg --arm64 --publish never",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "node --import tsx --test server/*.test.ts electron/*.test.ts electron/*.test.mjs src/lib/*.test.ts src/components/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "build": {
    "appId": "com.experimentplanner.desktop",
    "productName": "Experiment Planner",
    "afterPack": "electron/after-pack.mjs",
    "asar": true,
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist-electron/**/*.map",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.svg",
      "identity": null,
      "minimumSystemVersion": "12.0",
      "extendInfo": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "127.0.0.1": {
              "NSIncludesSubdomains": false,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
